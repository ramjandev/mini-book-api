generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  createdArt DateTime @default(now())
  updatedArt DateTime @updatedAt
  books      Book[]
}

model Book {
  id           String   @id @default(cuid())
  title        String
  description  String
  publishedArt String?
  createdArt   DateTime @default(now())
  updatedArt   DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
}
